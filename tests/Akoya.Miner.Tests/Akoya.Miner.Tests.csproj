<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for the miner's pure logic. Deliberately outside src/, so
       src/Directory.Build.props (the strict analyzer baseline) does not apply —
       test code is allowed to be noisier than production code.

       Scope: pure functions only. Everything here runs without a GPU, without a
       native backend, and without a network, so `dotnet test` is safe on any
       box. Anything needing randomx_capi / ghostrider_capi / a live pool belongs
       in a live run, not here. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The miner is AOT-published; the test host is not. Nothing here is
         reflection-hostile except the Metrics reset harness, which reflects over
         the test-time (JIT) build only. -->
    <PublishAot>false</PublishAot>
    <RootNamespace>Akoya.Miner.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Akoya.Miner\Akoya.Miner.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
